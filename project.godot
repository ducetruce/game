; Engine configuration file.
; Working title only -- `config/name` and the folder are trivial to rename.

config_version=5

[application]

config/name="Hollowmere"
config/description="A top-down monster-taming RPG. Original world, original creatures."
run/main_scene="res://scenes/overworld/overworld.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

; Parses data/*.json once at startup. No class_name on the script -- an
; autoload and a global class cannot share a name.
Content="*res://src/data/content.gd"

[display]

; Base render resolution: 320x180.
; 16px tiles -> 20 tiles wide. 16:9, so it integer-scales exactly to
; 1280x720 (4x), 1600x900 (5x) and 1920x1080 (6x) with no shimmer.
window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="keep"

[rendering]

; 0 = nearest neighbour. Without this every pixel-art asset is blurred.
textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.05, 0.05, 0.07, 1)

; Free movement puts the player at fractional world positions. Without
; these, sub-pixel offsets round differently frame to frame and the whole
; scene shimmers as you walk.
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true

[input]

